{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LasWebbsidan",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__BUCKET__/web/*"
    },
    {
      "Sid": "SkrivLoggar",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/logs/*"
    }
  ]
}