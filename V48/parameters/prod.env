# Parametrar för miljön "novatrix" (produktion).
# Värdena skickas till CloudFormation av deploy.sh. Varje template tar bara de
# parametrar den behöver. Inga hemligheter här: lösenord skapas av Secrets Manager.
# Skriv inga mellanslag runt "=" och inga mellanslag i värdena.

EnvName=novatrix
Region=eu-north-1

# Backup (01-backup.yaml)
BackupBucketName=novatrix-backup-02albper
BackupRetentionDays=14
LogRetentionDays=30
LogGroupRetentionDays=14

# Nätverk (03-network.yaml)
VpcCidr=10.0.0.0/16
MgmtCidr=10.0.0.0/24
PublicACidr=10.0.1.0/24
PublicBCidr=10.0.2.0/24
PrivateACidr=10.0.11.0/24
PrivateBCidr=10.0.12.0/24
# AdminCidr sätts automatiskt till din nuvarande IP, om du inte anger en här

# Databas (04-data.yaml). Single-AZ den här veckan för att hålla nere kostnaden.
DbInstanceClass=db.t4g.micro
DbAllocatedStorage=20
DbMultiAZ=false
DbBackupRetentionDays=1

# Servrar, lastbalanserare och Auto Scaling (05-app.yaml)
KeyName=novatrix-key
WebInstanceType=t3.micro
BastionInstanceType=t3.micro
AsgMinSize=2
AsgMaxSize=4
CpuTargetPercent=50
EnableDetailedMonitoring=true
