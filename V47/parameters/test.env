# Parametrar för en billigare testmiljö, byggd från samma templates.
# Används med: ./deploy.sh test
# Kräver ett eget, globalt unikt bucketnamn.

EnvName=novatrix-test
Region=eu-north-1

BackupBucketName=novatrix-test-backup-02albper
BackupRetentionDays=3
LogRetentionDays=7

VpcCidr=10.1.0.0/16
MgmtCidr=10.1.0.0/24
PublicACidr=10.1.1.0/24
PublicBCidr=10.1.2.0/24
PrivateACidr=10.1.11.0/24
PrivateBCidr=10.1.12.0/24

DbInstanceClass=db.t4g.micro
DbAllocatedStorage=20
DbMultiAZ=false
DbBackupRetentionDays=1

KeyName=novatrix-key
WebInstanceType=t3.micro
BastionInstanceType=t3.micro
AsgMinSize=1
AsgMaxSize=2
CpuTargetPercent=60
EnableDetailedMonitoring=false
